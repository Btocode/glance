#!/usr/bin/env python3
"""Test double for the gemini CLI. Only `error` replays a recorded shape (fixtures/backends/gemini-error.txt);
the success shapes are SYNTHETIC, written from gemini-cli's documented `-o json` / `-o stream-json` output
because no call ever succeeded on the spike machine (findings S6.4)."""
import json
import os
import sys
import time

FIX = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "fixtures", "backends")
GOOD = {"tone": "casual", "mismatch": True, "reason": "typos", "flags": [],
        "issues": [{"quote": "Teh", "occurrence": 1, "message": "Typo.", "replacement": "The", "kind": "grammar"}]}

stdin = sys.stdin.read()
if os.environ.get("FAKE_STDIN_LOG"):  # privacy proofs: everything any backend is ever sent
    with open(os.environ["FAKE_STDIN_LOG"], "a") as f:
        f.write(json.dumps({"argv": argv, "stdin": stdin}) + "\n")
log = os.environ.get("FAKE_LOG")
n = 0
if log:
    if os.path.exists(log):
        with open(log) as f:
            n = len(f.read().splitlines())
    with open(log, "a") as f:
        f.write(json.dumps({"argv": sys.argv[1:], "stdin": stdin, "cwd": os.getcwd()}) + "\n")

mode = os.environ.get("FAKE_MODE", "analyze")
if mode == "hang":
    time.sleep(30)
if mode == "error":
    with open(os.path.join(FIX, "gemini-error.txt")) as f:
        sys.stderr.write("".join(x for x in f if not x.startswith("[exit=")))
    sys.exit(1)
if "stream-json" in sys.argv:
    for t in ("The quick ", "brown fox."):
        print(json.dumps({"type": "message", "role": "assistant", "content": t, "delta": True}))
    print(json.dumps({"type": "result", "status": "success"}))
    sys.exit(0)
if mode == "analyze":
    resp = "```json\n" + json.dumps(GOOD) + "\n```"
elif mode == "prose":
    resp = "Sure! Here is my review of your text." if n == 0 else json.dumps(GOOD)
else:
    resp = "unused"
print("Loaded cached credentials.", file=sys.stderr)
print(json.dumps({"response": resp, "stats": {}}))
